{
  "manifest_version": 3,
  "name": "English Tutor",
  "version": "0.3.1",
  "description": "Write English, let an LLM underline grammar, vocabulary and syntax errors, and learn from each one.",
  "browser_specific_settings": {
    "gecko": {
      "id": "english-tutor@rm4n0s.dev",
      "update_url": "https://raw.githubusercontent.com/rm4n0s/english-tutor-releases/main/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "English Tutor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "open-tutor": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open the English Tutor page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self'"
  },
  "incognito": "not_allowed",
  "permissions": [
    "storage",
    "menus",
    "menus.overrideContext",
    "notifications",
    "downloads",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-ui.html", "page-ui.js", "page-ui.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
